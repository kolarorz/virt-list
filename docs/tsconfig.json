{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@virt-list/core": ["../packages/core/src/index.ts"],
      "@virt-list/vanilla": ["../packages/vanilla/src/index.ts"],
      "@virt-list/vue": ["../packages/vue/src/index.ts"],
      "@virt-list/vue2": ["../packages/vue2/src/index.ts"],
      "@virt-list/react": ["../packages/react/src/index.ts"],
      "@virt-list/react-legacy": ["../packages/react-legacy/src/index.ts"]
    }
  },
  "include": [
    ".vitepress/**/*.ts",
    ".vitepress/**/*.d.ts",
    ".vitepress/**/*.vue",
    "**/*.md"
  ]
}
