{
  "name": "@virt-list/react-legacy",
  "version": "0.0.9",
  "description": "React 16-17 virtual list, grid and tree components",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-styles.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0"
  },
  "dependencies": {
    "@virt-list/core": "workspace:*",
    "@virt-list/vanilla": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=16.8 <18",
    "react-dom": ">=16.8 <18"
  },
  "keywords": [
    "react",
    "react16",
    "react17",
    "virtual-list",
    "virtual-tree",
    "virtual-grid"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kolarorz/virt-list",
    "directory": "packages/react-legacy"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
